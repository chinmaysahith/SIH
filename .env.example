# ==============================================================================
# Email Fraud Forensic Analysis Platform - Environment Configuration Template
# ==============================================================================

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Frontend Service Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Stage 1: Evidence Upload & Quarantine Configuration
# ------------------------------------------------------------------------------
# Maximum permitted upload size in Megabytes (default: 25MB)
MAX_UPLOAD_SIZE_MB=25

# Quarantine storage path (defaults to ./data/quarantine relative to project root)
# QUARANTINE_DIR=./data/quarantine

# SQLite Database Location
DATABASE_URL=sqlite:///./data/forensic_cases.db

# ------------------------------------------------------------------------------
# Stage 1.5: Redis & RQ Background Job Queue Configuration
# ------------------------------------------------------------------------------
# Redis connection URL (inside Docker: redis://redis:6379/0, local dev: redis://localhost:6379/0)
REDIS_URL=redis://redis:6379/0

# Designated RQ queue name for email analysis jobs
QUEUE_NAME=email_analysis

# ------------------------------------------------------------------------------
# Future Stage Configuration Placeholders (Do NOT commit real keys)
# ------------------------------------------------------------------------------

# Threat Intelligence APIs (Stage 2+)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# GeoIP & Origin Lookup (Stage 2+)
# MAXMIND_LICENSE_KEY=your_maxmind_license_key_here
